# ============================================
# CRYPTONS.COM ENVIRONMENT CONFIGURATION
# ============================================
# ⚠️ SECURITY WARNING: Never commit .env files to version control
# ⚠️ PRODUCTION: Change ALL default values before deployment
# ⚠️ Use secrets management (Vault, AWS Secrets Manager) in production

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
DEFAULT_LANGUAGE=en
CFV_METRICS_API_URL=http://localhost:3000
CFV_CACHE_TTL=300
CFV_ENABLED=true

# ============================================
# DATABASE CONFIGURATION
# ============================================
# MongoDB Connection String
# PRODUCTION: Use authentication, TLS, and replica sets
# Example with auth: mongodb://username:password@host:27017/cryptons?authSource=admin&tls=true
MONGODB_URI=mongodb://localhost:27017/cryptons

# Database User (if using authentication)
MONGODB_USER=
MONGODB_PASSWORD=

# ============================================
# JWT AUTHENTICATION
# ============================================
# ⚠️ CRITICAL: Generate strong random secrets (minimum 32 characters)
# Generate with: openssl rand -hex 32
# NEVER use default values in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_EXPIRE=30d

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Cryptons
SMTP_FROM_EMAIL=noreply@cryptons.com
ADMIN_EMAIL=admin@cryptons.com

# Generic webhook signature secret (src/middleware/webhookAuth.js)
# Generate with: openssl rand -hex 64
WEBHOOK_SECRET=generate-64-char-hex-string-for-webhook-verification

# ============================================
# LOGGING AND SEEDING
# ============================================
# Logging
LOG_LEVEL=info
# Data Seeding
SEED_DATA=true

# ============================================
# CORS CONFIGURATION (CRITICAL FOR PRODUCTION)
# ============================================
# Comma-separated list of allowed origins
# DEVELOPMENT: localhost origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# PRODUCTION: Use specific domains only, NO wildcards
# ALLOWED_ORIGINS=https://cryptons.com,https://www.cryptons.com,https://app.cryptons.com

CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ============================================
# REDIS CONFIGURATION (for JWT token revocation)
# ============================================
# Required for production JWT token revocation
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
JWT_BLACKLIST_TTL=86400

# Behaviour when Redis (the revocation store) is unavailable:
#   open   = allow tokens through (availability first; revoked/logged-out tokens
#            are briefly honoured again during a Redis outage) — historical default
#   closed = deny all token auth while Redis is down (fail secure; revocation can
#            never be bypassed, but an outage logs everyone out)
# A degraded check always emits a `security.token_revocation.degraded` log event
# for alerting. See docs/security/JWT_TOKEN_REVOCATION.md#fail-mode-policy
TOKEN_REVOCATION_FAIL_MODE=open
# Dev/test only: keep revocations in-process when Redis is not running, so
# logout and password-change revocation work on a single local instance.
# Ignored unless NODE_ENV is development or test. Never use in production.
TOKEN_REVOCATION_LOCAL_STORE=false

# Skip webhook verification in development (NOT for production)
SKIP_WEBHOOK_VERIFICATION=false
WEBHOOK_TOLERANCE=300

# Block requests without origin header in production CORS
CORS_BLOCK_NO_ORIGIN=false

# ============================================
# SECRETS MANAGEMENT (Production)
# ============================================
# Secrets provider: vault, aws, or env (default)
SECRETS_PROVIDER=env
SECRETS_CACHE_TTL=3600

# HashiCorp Vault configuration
VAULT_ENABLED=false
VAULT_ADDR=https://vault.cryptons.com:8200
VAULT_URL=https://vault.cryptons.com:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_TOKEN=

# AWS Secrets Manager configuration
AWS_SECRETS_ENABLED=false
AWS_SECRETS_REGION=us-east-1

# ============================================
# DATABASE ENCRYPTION
# ============================================
# Enable MongoDB encryption at rest (Enterprise only)
MONGODB_ENCRYPTION_ENABLED=false
MONGODB_ENCRYPTION_KEY_FILE=/etc/mongodb/mongodb-keyfile
MONGODB_ENCRYPTION_CIPHER=AES256-GCM

# Field-level encryption key (64-character hex string)
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=
ENABLE_FIELD_ENCRYPTION=false

# TLS/SSL for database connections (REQUIRED for production)
MONGODB_TLS_ENABLED=false
MONGODB_TLS_CA_FILE=/etc/mongodb/ca.pem
MONGODB_TLS_CERT_FILE=/etc/mongodb/mongodb-cert.pem

# ============================================
# ELASTICSEARCH CONFIGURATION (Optional)
# ============================================
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ============================================
# TLS/HTTPS ENFORCEMENT
# ============================================
# Force HTTPS in production
FORCE_HTTPS=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# ============================================
# SECURITY HEADERS
# ============================================
# Additional security configuration
HELMET_CSP_ENABLED=true
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ============================================
# MONITORING AND LOGGING
# ============================================
LOG_LEVEL=info
# In production, send logs to centralized logging service
# Options: error, warn, info, http, verbose, debug
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Database Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
AWS_S3_BACKUP_BUCKET=
MONGODB_BACKUP_PATH=/backups

# Monitoring Configuration
PROMETHEUS_ENABLED=false
GRAFANA_ADMIN_PASSWORD=
METRICS_PORT=9090
ALERT_WEBHOOK_URL=
ALERT_EMAIL=

# Centralized Logging (ELK Stack)
ELK_ENABLED=false
ELASTICSEARCH_URL=http://localhost:9200
LOG_RETENTION_DAYS=90

# High Availability Configuration
MONGODB_REPLICA_SET=
MONGODB_REPLICA_MEMBERS=
MONGODB_READ_PREFERENCE=primaryPreferred
MONGODB_WRITE_CONCERN=majority
MONGODB_POOL_SIZE=20
FAILOVER_TIMEOUT=5000
SLOW_QUERY_THRESHOLD=1000

# Performance Configuration
CACHE_ENABLED=false
CACHE_TTL=3600
COMPRESSION_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true
SLOW_REQUEST_THRESHOLD=2000

# Network Security
NETWORK_POLICIES_ENABLED=false
VPC_CIDR=10.0.0.0/16
WAF_ENABLED=false
VPN_ENABLED=false
ADMIN_IP_WHITELIST=

# ============================================
# KYC/AML COMPLIANCE CONFIGURATION
# ============================================
# KYC Provider Configuration
KYC_PROVIDER=manual
# Jumio configuration (optional)
JUMIO_API_TOKEN=
JUMIO_API_SECRET=
# Onfido configuration (optional)
ONFIDO_API_TOKEN=
# Sumsub configuration (optional)
SUMSUB_APP_TOKEN=
# KYC webhook secret for provider callbacks
KYC_WEBHOOK_SECRET=

# ============================================
# AML/TRANSACTION MONITORING
# ============================================
# Enable AML monitoring
AML_ENABLED=true
# Sanctions screening API key (if using external service)
SANCTIONS_API_KEY=
# Risk thresholds (0-100)
RISK_THRESHOLD_HIGH=85
RISK_THRESHOLD_MEDIUM=50
# Automatic blocking threshold
AUTO_BLOCK_THRESHOLD=95
# Manual review threshold
MANUAL_REVIEW_THRESHOLD=75

# ============================================
# GDPR COMPLIANCE
# ============================================
# Enable GDPR features
GDPR_ENABLED=true
# Data retention period in days (default: 7 years = 2555 days)
DATA_RETENTION_DAYS=2555
# Require user consent for data processing
CONSENT_REQUIRED=true
# Privacy policy version
PRIVACY_POLICY_VERSION=1.0
# Data controller contact email
DATA_CONTROLLER_EMAIL=privacy@cryptons.com

# ============================================
# REGULATORY REPORTING
# ============================================
# Enable FinCEN reporting
FINCEN_ENABLED=false
# FinCEN BSA ID (for CTR/SAR filing)
FINCEN_BSA_ID=
# FinCEN User ID
FINCEN_USER_ID=
# Enable state-level reporting
STATE_REPORTING_ENABLED=false
# Enable tax reporting
TAX_REPORTING_ENABLED=false
# Reporting schedule (daily, weekly, monthly)
REPORTING_SCHEDULE=daily

# ============================================
# COMPLIANCE MANAGEMENT
# ============================================
# Compliance officer email
COMPLIANCE_OFFICER_EMAIL=compliance@cryptons.com
# Enable compliance alerts
COMPLIANCE_ALERTS_ENABLED=true
# Enable audit logging
AUDIT_LOGGING_ENABLED=true
# Risk assessment frequency (daily, weekly, monthly)
RISK_ASSESSMENT_FREQUENCY=monthly
# Policy review frequency (monthly, quarterly, annually)
POLICY_REVIEW_FREQUENCY=quarterly

# ============================================
# LEGAL DOCUMENTATION
# ============================================
# Legal jurisdiction
LEGAL_JURISDICTION=US
# Terms of Service version
TERMS_VERSION=1.0
# Privacy Policy version
PRIVACY_VERSION=1.0
# Risk Disclosure version
RISK_DISCLOSURE_VERSION=1.0
# Document signing provider (docusign, manual)
DOCUMENT_SIGNING_PROVIDER=manual

# ============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================
# Before deploying to production, ensure:
# [ ] All secrets changed from defaults
# [ ] Strong random values for JWT_SECRET and JWT_REFRESH_SECRET
# [ ] CORS configured with specific allowed origins
# [ ] Database authentication and TLS enabled
# [ ] Redis enabled for token revocation
# [ ] Webhook secret generated and configured
# [ ] Field encryption key generated
# [ ] Monitoring and logging configured
# [ ] Secrets management (Vault) enabled
# [ ] Environment set to 'production'
# [ ] All placeholder values replaced
# [ ] Security audit completed
# [ ] Compliance requirements verified
# [ ] KYC/AML program implemented and tested
# [ ] Legal documents reviewed by counsel

# ============================================
# v3.0 CONTENT MODERATION & SAFETY (PARAMOUNT)
# ============================================
# PhotoDNA (Microsoft) — CSAM hash matching
PHOTODNA_ENABLED=false
PHOTODNA_API_KEY=
PHOTODNA_PRIVATE_API_URL=https://api.photodna.com/v1/hashing

# AWS Rekognition — Image content moderation
AWS_REKOGNITION_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Azure AI Content Safety
AZURE_CONTENT_SAFETY_ENABLED=false
AZURE_CONTENT_SAFETY_KEY=
AZURE_CONTENT_SAFETY_ENDPOINT=

# OpenAI Moderation API
OPENAI_MODERATION_ENABLED=false
OPENAI_API_KEY=

# Google Perspective API (toxicity / threat detection)
PERSPECTIVE_API_ENABLED=false
PERSPECTIVE_API_KEY=

# ============================================
# v3.0 AUTHORITY REPORTING
# ============================================
# NCMEC CyberTipline (mandatory for CSAM)
NCMEC_CYBERTIPLINE_API_URL=https://api.cybertipline.org/v1
NCMEC_API_KEY=

# Platform legal identity (for NCMEC reports)
PLATFORM_LEGAL_NAME=Cryptons.com
COMPLIANCE_OFFICER_NAME=
# COMPLIANCE_OFFICER_EMAIL already defined above

# Law Enforcement portal access key — rotate regularly, treat as secret
# Generate with: openssl rand -hex 32
LAW_ENFORCEMENT_API_KEY=

# FinCEN BSA E-Filing (for SAR submissions)
FINCEN_BSA_API_URL=https://bsaefiling.fincen.treas.gov/api

# ============================================
# v3.0 B2C MULTI-SELLER (Stripe Connect)
# ============================================
# Stripe Connect for marketplace payouts
STRIPE_CONNECT_ENABLED=false
STRIPE_CONNECT_CLIENT_ID=
# STRIPE_SECRET_KEY already defined above

# ============================================
# v3.0 AUCTION ENGINE
# ============================================
# Auction closer scheduler interval in milliseconds (default: 60000 = 1 minute)
AUCTION_CLOSER_INTERVAL_MS=60000

# ============================================
# v3.0 C2C MARKETPLACE
# ============================================
# Google Maps Places API for safe meeting location suggestions
GOOGLE_MAPS_API_KEY=

# C2C listing default expiry in days
C2C_LISTING_EXPIRY_DAYS=30


# ============================================
# DGD NON-CUSTODIAL ESCROW (dgd-core bridge)
# ============================================
# URL of the dgd-core internal service (Marketplace escrow + price)
DGD_CORE_URL=http://127.0.0.1:3200
# Bearer token guarding the dgd-core funds API (required in production)
DGD_CORE_AUTH_TOKEN=
# Min confirmations before treating an escrow as funded (default 1)
DGD_CONFIRMATIONS=1

# Independent arbitrator key → DGD escrows open 2-of-3 (mediatable on dispute).
# Unset → 2-of-2 (cancel-refund only, no dispute path).
DGD_ARBITRATOR_PUBKEY=
DGD_ARBITRATOR_PAYOUT_ADDRESS=
# Optional default seller (User id) when a product has no seller set
DEFAULT_PLATFORM_SELLER_ID=
